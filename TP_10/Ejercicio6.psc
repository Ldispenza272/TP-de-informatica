
// ANALISIS E/P/S
// Entrada: radio y altura del cilindro
// Proceso: calcular el volumen utilizando la fórmula ? * radio² * altura
// Salida: volumen del cilindro
	

Proceso  Ejercicio_6
	
    Definir radio, altura, volumen Como Real;
	
    Escribir "Ingrese el radio del cilindro:";
    Leer radio;
	
    Escribir "Ingrese la altura del cilindro:";
    Leer altura;
	
    volumen <- PI * radio * radio * altura;
	
    Escribir "El volumen del cilindro es: ", volumen;
	
FinProceso
