
// ANALISIS E/P/S
// Entrada: cantidad de dinero en pesos
// Proceso: dividir los pesos por el valor del euro
// Salida: cantidad equivalente en euros

Proceso  Ejercicio_4
	
	
    Definir pesos, euros Como Real;
    Definir valor_euro Como Real;
	
    valor_euro <- 0;
	
    Escribir "Ingrese la cantidad de pesos:";
    Leer pesos;
	
    euros <- pesos / valor_euro;
	
    Escribir "La cantidad equivalente en euros es: ", euros;
	
FinProceso

